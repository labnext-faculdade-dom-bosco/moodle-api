# URL do Moodle que a API vai consumir (o de produção).
MOODLE_BASE_URL=https://moodle.exemplo.com.br

# Token de um usuário com acesso aos web services desse Moodle.
MOODLE_TOKEN=

API_PORT=8000

# RESTART_POLICY: política de restart dos containers.
# Em prod, use "always" para o container voltar sozinho se a máquina reiniciar.
RESTART_POLICY=always
